# Alpine-based ISC Kea DHCPv4 (multi-arch: amd64/arm64)
FROM alpine:latest
LABEL org.opencontainers.image.authors="admin@klausk.xyz" \
      org.opencontainers.image.title="kea-dhcp4" \
      org.opencontainers.image.description="ISC Kea DHCPv4 with HA and lease-cmds hooks"

RUN apk --no-cache upgrade \
 && apk --no-cache add \
        kea-dhcp4 \
        kea-hook-ha \
        kea-hook-lease-cmds \
        curl \
        jq

COPY entrypoint.sh.kea-dhcp4 /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# TLS certs and kea-*.json are mounted here at runtime — never bake secrets into the image
VOLUME [ "/etc/kea", "/var/lib/kea", "/run/kea" ]

EXPOSE 67/tcp 67/udp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
