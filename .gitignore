# Private key material — never commit
*.key
*.p12
*.pfx
*.pem
!pki/**/*.cnf

# OpenSSL CA working state
pki/index.txt
pki/index.txt.old
pki/index.txt.attr
pki/index.txt.attr.old
pki/serial
pki/serial.old
pki/certs/
pki/newcerts/
pki/crl/
pki/*.csr
pki/**/*.csr

# Keep openssl configs and docs
!pki/**/openssl.cnf
!pki/README.md

# Local / editor
.DS_Store
*.swp
*~
.env
.env.*
!.env.example

# Runtime config bind mounts (site kea JSON) — keep examples tracked
/config/kea-dhcp4/
/config/kea-dhcp-ddns/
!/config/examples/
!/config/examples/**

# Runtime TLS bind mounts (never commit private keys)
/certs/

# Build artifacts
*.tar
*.tar.gz
