# Used by CI compose validation and as a local starting point.
# Point *_CONFIG_DIR at directories that contain the real kea-*.json (+ certs).

KEA_DHCP4_IMAGE=isc-kea/kea-dhcp4:test
KEA_DDNS_IMAGE=isc-kea/kea-dhcp-ddns:test
KEA_DHCP4_CONTAINER_NAME=kea-dhcp4-env-test
KEA_DDNS_CONTAINER_NAME=kea-dhcp-ddns-env-test
KEA_DHCP4_CONFIG_DIR=/tmp/kea-dhcp4-config-test
KEA_DDNS_CONFIG_DIR=/tmp/kea-ddns-config-test
