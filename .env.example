# Used by CI compose validation and as a local starting point.
# Point *_CONFIG_DIR at directories with kea-*.json (no secrets).
# Point *_CERT_DIR at directories with ca.pem / cert.pem / key.pem from pki/.

KEA_DHCP4_IMAGE=isc-kea/kea-dhcp4:test
KEA_DDNS_IMAGE=isc-kea/kea-dhcp-ddns:test
KEA_DHCP4_CONTAINER_NAME=kea-dhcp4-env-test
KEA_DDNS_CONTAINER_NAME=kea-dhcp-ddns-env-test
KEA_DHCP4_CONFIG_DIR=/tmp/kea-dhcp4-config-test
KEA_DDNS_CONFIG_DIR=/tmp/kea-ddns-config-test
KEA_DHCP4_CERT_DIR=/tmp/kea-dhcp4-cert-test
KEA_DDNS_CERT_DIR=/tmp/kea-ddns-cert-test
KEA_UID=12345
KEA_GID=12346
TZ=UTC
# Control-channel healthchecks (status-get). Use https://HOST:PORT/ in production.
KEA_DHCP4_HEALTHCHECK_URL=http://127.0.0.1:8001/
KEA_DDNS_HEALTHCHECK_URL=http://127.0.0.1:8002/
KEA_HEALTHCHECK_INSECURE=true
