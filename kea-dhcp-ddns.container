# /etc/containers/systemd/kea-dhcp-ddns.container
# Quadlet unit — after editing: systemctl daemon-reload && systemctl restart kea-dhcp-ddns
[Unit]
Description=ISC Kea DHCP DDNS
After=network-online.target
Wants=network-online.target

[Container]
# Replace with an immutable release tag or manifest digest before installing.
Image=ghcr.io/theaustrian75/isc-kea/kea-dhcp-ddns@sha256:REPLACE_WITH_MANIFEST_DIGEST
ContainerName=kea-dhcp-ddns
User=0
Group=0
Environment=KEA_UID=100
Environment=KEA_GID=101
Environment=TZ=America/New_York
Network=host
Volume=/srv/kea/dhcp-ddns:/etc/kea:ro,Z
Tmpfs=/run/kea:rw,size=16m,uid=100,gid=101,mode=0750
Tmpfs=/tmp:rw,size=16m,mode=1777
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
# No NET_BIND_SERVICE: DDNS listens on 53001 (>1024).
AddCapability=CAP_CHOWN
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID
AddCapability=CAP_DAC_OVERRIDE
PidsLimit=128
Memory=256m
StopTimeout=15
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
