{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [ "lo" ],
      "dhcp-socket-type": "udp"
    },
    "control-sockets": [
      {
        "socket-type": "unix",
        "socket-name": "/run/kea/kea4-ctrl-socket"
      },
      {
        "socket-type": "http",
        "socket-address": "127.0.0.1",
        "socket-port": 8001
      }
    ],
    "lease-database": {
      "type": "memfile",
      "persist": false,
      "name": "/var/lib/kea/dhcp4-@@PEER@@.leases"
    },
    "hooks-libraries": [
      {
        "library": "/usr/lib/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/kea/hooks/libdhcp_ha.so",
        "parameters": {
          "high-availability": [
            {
              "this-server-name": "@@PEER@@",
              "mode": "hot-standby",
              "heartbeat-delay": 1000,
              "max-response-delay": 10000,
              "max-ack-delay": 5000,
              "max-unacked-clients": 0,
              "peers": [
                {
                  "name": "dhcp1",
                  "url": "http://@@DHCP1_IP@@:8000/",
                  "role": "primary",
                  "auto-failover": true
                },
                {
                  "name": "dhcp2",
                  "url": "http://@@DHCP2_IP@@:8000/",
                  "role": "standby",
                  "auto-failover": true
                }
              ]
            }
          ]
        }
      }
    ],
    "subnet4": [
      {
        "id": 1,
        "subnet": "127.0.0.0/8",
        "pools": [ { "pool": "127.0.0.10 - 127.0.0.20" } ]
      }
    ],
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [ { "output": "stdout" } ],
        "severity": "INFO"
      }
    ]
  }
}
