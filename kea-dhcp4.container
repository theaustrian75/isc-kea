# /etc/containers/systemd/kea-dhcp4.container
# Quadlet unit — after editing: systemctl daemon-reload && systemctl restart kea-dhcp4
[Unit]
Description=ISC Kea DHCPv4 (HA-capable)
After=network-online.target
Wants=network-online.target

[Container]
# Replace with an immutable release tag or manifest digest before installing.
Image=ghcr.io/theaustrian75/isc-kea/kea-dhcp4@sha256:REPLACE_WITH_MANIFEST_DIGEST
ContainerName=kea-dhcp4
# Match Host UID/GID to volume ownership. Change User, Group, Environment, and
# Tmpfs uid/gid together when remapping.
User=0
Group=0
Environment=KEA_UID=100
Environment=KEA_GID=101
Environment=TZ=America/New_York
# status-get against the HTTPS control socket (match kea-dhcp4.json)
Environment=KEA_HEALTHCHECK_URL=https://127.0.0.1:8001/
Environment=KEA_HEALTHCHECK_INSECURE=true
# Host networking is typical for DHCP servers.
Network=host
Volume=/srv/kea/dhcp4:/etc/kea:ro,Z
# TLS material: ca.pem, cert.pem, key.pem (from pki/; never bake into the image)
Volume=/srv/kea/dhcp4-certs:/etc/kea/certs:ro,Z
Volume=kea-dhcp4-data.volume:/var/lib/kea
Tmpfs=/run/kea:rw,size=16m,uid=100,gid=101,mode=0750
Tmpfs=/tmp:rw,size=16m,mode=1777
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_NET_RAW
AddCapability=CAP_CHOWN
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID
AddCapability=CAP_DAC_OVERRIDE
PidsLimit=256
Memory=512m
StopTimeout=15
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
