{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [ "eth0" ],
      "dhcp-socket-type": "raw"
    },
    "control-sockets": [
      {
        "socket-type": "unix",
        "socket-name": "/run/kea/kea4-ctrl-socket"
      },
      {
        "socket-type": "https",
        "socket-address": "0.0.0.0",
        "socket-port": 8001,
        "trust-anchor": "/etc/kea/certs/control/ca.pem",
        "cert-file": "/etc/kea/certs/control/cert.pem",
        "key-file": "/etc/kea/certs/control/key.pem"
      }
    ],
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/dhcp4.leases"
    },
    "hooks-libraries": [
      {
        "library": "/usr/lib/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/kea/hooks/libdhcp_ha.so",
        "parameters": {
          "high-availability": [
            {
              "this-server-name": "dhcp1",
              "mode": "hot-standby",
              "heartbeat-delay": 10000,
              "max-response-delay": 60000,
              "max-ack-delay": 5000,
              "max-unacked-clients": 5,
              "trust-anchor": "/etc/kea/certs/ha/ca.pem",
              "cert-file": "/etc/kea/certs/ha/cert.pem",
              "key-file": "/etc/kea/certs/ha/key.pem",
              "peers": [
                {
                  "name": "dhcp1",
                  "url": "https://dhcp1.example.com:8000/",
                  "role": "primary",
                  "auto-failover": true
                },
                {
                  "name": "dhcp2",
                  "url": "https://dhcp2.example.com:8000/",
                  "role": "standby",
                  "auto-failover": true
                }
              ]
            }
          ]
        }
      }
    ],
    "subnet4": [
      {
        "id": 1,
        "subnet": "10.0.0.0/24",
        "pools": [ { "pool": "10.0.0.100 - 10.0.0.200" } ]
      }
    ],
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [ { "output": "stdout" } ],
        "severity": "INFO"
      }
    ]
  }
}
